node_modules
dist
.ssr
.vite
.DS_Store
.env
.env.local

# Large media — host on CDN, not git
public/**/*.mp4
public/**/*.mov
# public/reel-preview.gif — committed, small enough

# Allow compressed grid videos
!public/grid/*-compressed.mp4

# Same allowance for card artwork, which lives a directory up. The -compressed
# suffix is the contract either way: a file carrying it has been through a
# transcode and is small enough to live in git. Masters do not, and stay out.
!public/*-compressed.mp4

# Grid placeholder images — serve from CDN or Sanity, not git
public/grid/*.png
public/grid/*.jpg

# Allow named compressed grid images
!public/grid/*-compressed.jpg
.vercel
.env*
